# 知乎开放平台 Access Secret（developer.zhihu.com/profile 获取）
ZHIHU_ACCESS_SECRET=

# 远程 Redis 连接串，两台开发机与线上部署共用同一实例——配额账本全局一份（README §4.6）
# 密码包含在 URL 中，ioredis 自动解析认证；密码含 @ : / # 等字符需 URL 编码（@ → %40）
# 格式示例：
#   Upstash（自带密码，用户名 default，TLS）：rediss://default:密码@xxx.upstash.io:6379
#   自建只有密码（requirepass，用户名留空但冒号保留）：redis://:密码@主机:6379
#   用户名+密码（Redis 6+ ACL / Sealos）：redis://用户名:密码@主机:6379
REDIS_URL=
